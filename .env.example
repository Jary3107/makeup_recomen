# Plantilla segura de variables de entorno para CustomMatch
# Copia este archivo como `.env` y coloca tus credenciales reales (el archivo `.env` está protegido por `.gitignore`)

VERTEX_PROJECT=projects/TU_PROYECTO_AQUI
AI_API_KEY=TU_CLAVE_API_AQUI

TIDB_HOST=TU_HOST_TIDB_CLOUD
TIDB_PORT=4000
TIDB_USER=TU_USUARIO_TIDB
TIDB_PASSWORD=TU_PASSWORD_TIDB
TIDB_DATABASE=test
TIDB_SSL=true
